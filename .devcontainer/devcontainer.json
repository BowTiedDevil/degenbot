// degenbot devcontainer — committed in-repo. VSCode auto-discovers this file.
//
// Usage:
//   1. One-time: set "dev.containers.dockerPath": "podman" in VSCode user settings.
//   2. Open this repo in VSCode → "Dev Containers: Reopen in Container".
//
// First build builds the Dockerfile (the dnf layer is the slow part), then
// runs post-create.sh (venv + uv sync; foundry and pi are baked into the
// Dockerfile image). Subsequent starts reuse the named container VSCode
// created — instant.
//
// Podman note: mounts are plain type=bind (no consistency=cached, which is
// Docker-Desktop-only). VSCode's podman dockerPath handles the runtime.
{
  "name": "degenbot",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "runArgs": [
    // Removing the default cgroup PID cap so heavy test spawning 
    // (cargo, pytest, forge) never hits the limit.
    "--pids-limit=-1"
  ],
  "remoteUser": "dev",
  "workspaceFolder": "/workspaces/degenbot",
  "shutdownAction": "none", // keep the container running if VSCode disconnects
  // No devcontainer features — python, rust, node, just, uv, tmux, git are all
  // baked into the Dockerfile via dnf (fedora:latest). foundry (foundryup)
  // and pi (npm i -g) are ALSO baked into the image — they used to live in
  // post-create.sh but were promoted into the Dockerfile because the 
  // entry point (attach.sh) does `podman start`+`exec`, which does NOT
  // run postCreateCommand, so post-create-installed tools went missing after
  // any container recreate.
  // Bind-mount the host's /etc/localtime (read-only) so the container's
  // timezone matches the host. glibc resolves the zone through this file/
  // symlink, so every process (date, logs, Python datetime.now()) reports
  // host-local time without needing a separate TZ env var. The TZ env var
  // below is also forwarded for tools that prefer it; on hosts without TZ
  // exported it resolves to empty and falls back to /etc/localtime.
  "mounts": [
    "source=/etc/localtime,target=/etc/localtime,type=bind,readonly=true",
    "source=${localEnv:HOME}/.agents,target=/home/dev/.agents,type=bind",
    "source=${localEnv:HOME}/.config/degenbot,target=/home/dev/.config/degenbot,type=bind",
    "source=${localEnv:HOME}/.foundry,target=/home/dev/.foundry,type=bind",
    "source=${localEnv:HOME}/.pi,target=/home/dev/.pi,type=bind",
    "source=${localEnv:HOME}/code/shared,target=/shared,type=bind"
  ],
  // PATH additions for the npm-global pi binary (~/.local/bin; npm prefix
  // in the Dockerfile makes `npm i -g` land there) and foundry
  // (~/.foundry/bin, curl-installed in the Dockerfile). Both are baked into the
  // image; these remoteEnv/containerEnv entries just ensure they're on PATH for
  // VSCode-launched shells too. cargo/just/node/python/uv are in /usr/bin from
  // dnf and already on the default PATH.
  // Network (host.containers.internal, see comment above) gives the dev
  // container host-loopback access to the local Ethereum node, so tests.env
  // points at host.containers.internal:8545/8546. Pod membership and
  // `--network=container:mainnet_node` were both attempted and rejected by
  // podman — details in the runArgs/network comment above.
  // All environment variables live in containerEnv (baked into the image's
  // Config.Env, visible to EVERY process including `podman exec` shells from
  // attach.sh) rather than remoteEnv (only injected by the VSCode runtime
  // into shells IT spawns — invisible to podman exec, so useless for the
  // terminal-only workflow this container serves). PATH augmentation for foundry/pi
  // is set directly in the Dockerfile via `ENV PATH=...`, not here.
  "containerEnv": {
    "LOCAL_BIN": "/home/dev/.local/bin",
    "FOUNDRY_DIR": "/home/dev/.foundry",
    // UV_PROJECT_ENVIRONMENT points uv at a container-local venv (outside the
    // bind-mounted repo) instead of the in-repo .venv. This is the fix for the
    // shared-venv poisoning between host (/home/btd/...) and container
    // (/workspaces/...): uv bakes the venv's absolute path into pyvenv.cfg and
    // every console-script shebang (.venv/bin/pytest, etc.), so a single shared
    // .venv alternates between working and broken as each side runs `uv sync`.
    // A container-local venv has self-consistent /home/dev/.venvs/... paths and
    // is never read by the host. It lives in the container's writable layer
    // (survives podman stop/start, wiped on --remove-existing-container) —
    // post-create.sh recreates it via `uv sync` on every rebuild.
    "UV_PROJECT_ENVIRONMENT": "/home/dev/.venvs/degenbot",
    // PYTHONPYCACHEPREFIX isolates bytecache per environment. Even with separate
    // venvs (above), the SOURCE TREE (__pycache__ under src/, tests/, conftest
    // files) is still bind-mounted and shared. CPython bakes the absolute
    // compile-time path (co_filename) into every .pyc; a pyc built in the
    // container then loaded on the host carries /workspaces/... paths that break
    // Sybil's pytest_collect_file (README.md tests vanish) and any tooling that
    // reads co_filename. Redirecting pycs to a per-environment prefix keeps each
    // side's bytecache self-consistent while preserving the import-speedup
    // benefit. The prefix differs from the host's
    // (/tmp/degenbot-pycache-host, set in the justfile) so the two environments
    // never share a bytecache.
    "PYTHONPYCACHEPREFIX": "/tmp/degenbot-pycache-container",
    // Forward host TZ (if exported) for tools that read the env var directly.
    // Empty on hosts without TZ exported — falls back to bind-mounted
    // /etc/localtime above.
    "TZ": "${localEnv:TZ}",
    // Ethereum RPC URIs. The host's tests.env points these at localhost:8545
    // (the local anvil node, reachable via pasta port-forwarding). Inside the
    // container "localhost" is the container's own loopback, not the host's —
    // so these containerEnv entries override the shared tests.env values to
    // host.containers.internal:8545, which podman resolves to the host
    // loopback where anvil listens. Precedence (envvar > tests.env > default)
    // is implemented in tests/conftest.py:_rpc, so containerEnv always wins
    // here without editing the bind-mounted tests.env.
    "ETHEREUM_ARCHIVE_NODE_HTTP_URI": "http://host.containers.internal:8545/",
    "ETHEREUM_ARCHIVE_NODE_WS_URI": "ws://host.containers.internal:8546/",
    "ETHEREUM_FULL_NODE_HTTP_URI": "http://host.containers.internal:8545/",
    "ETHEREUM_FULL_NODE_WS_URI": "ws://host.containers.internal:8546/"
  },
  // Extensions auto-installed into the container on first launch. The interpreter
  // is pinned to the container-local venv (UV_PROJECT_ENVIRONMENT above), NOT the
  // in-repo .venv — .vscode/settings.json pins the host venv; these container
  // settings override it inside the devcontainer.
  "customizations": {
    "vscode": {
      "extensions": [
        "bierner.markdown-mermaid",
        "charliermarsh.ruff",
        "davidanson.vscode-markdownlint",
        "github.vscode-github-actions",
        "huff-language.huff-language",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "pkief.material-icon-theme",
        "rust-lang.rust-analyzer",
        "tintinweb.vscode-vyper"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/home/dev/.venvs/degenbot/bin/python",
        "python.venvPath": "/home/dev/.venvs"
      }
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh"
}