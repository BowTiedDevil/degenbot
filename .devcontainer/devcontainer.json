// degenbot devcontainer — committed in-repo. VSCode auto-discovers this file.
//
// Usage:
//   1. One-time: set "dev.containers.dockerPath": "podman" in VSCode user settings.
//   2. Open this repo in VSCode → "Dev Containers: Reopen in Container".
//
// First build builds the Dockerfile (the dnf layer is the slow part), then
// runs post-create.sh (venv + uv sync; foundry and pi are baked into the
// Dockerfile image). Subsequent starts reuse the named container VSCode
// created — instant.
//
// Podman note: mounts are plain type=bind (no consistency=cached, which is
// Docker-Desktop-only). VSCode's podman dockerPath handles the runtime.
{
  "name": "degenbot",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "dev",
  "workspaceFolder": "/workspaces/degenbot",
  // No devcontainer features — python, rust, node, just, uv, tmux, git are all
  // baked into the Dockerfile via dnf (fedora:latest). foundry (foundryup)
  // and pi (npm i -g) are ALSO baked into the image — they used to live in
  // post-create.sh but were promoted into the Dockerfile because the SSH
  // entry point (ssh-attach.sh) does `podman start`+`exec`, which does NOT
  // run postCreateCommand, so post-create-installed tools went missing after
  // any container recreate.
  // Reaching the host Ethereum node: the dev container uses podman's
  // built-in `host.containers.internal` hostname, which rootless podman
  // resolves to the host loopback where 8545/8546 listen. tests.env points
  // directly at `host.containers.internal:PORT`.
  //
  // Why not pod membership / namespace sharing (both tried, both blocked):
  //  - `runArgs: ["--pod", "systemd-ethereum"]` → podman error "cannot set
  //    user namespace mode when joining pod with infra container". The pod's
  //    infra container is `userns: host` (the validator containers need it to
  //    reach host ports/network), but the devcontainer CLI auto-injects
  //    `--userns=keep-id` under rootless podman so bind mounts like ~/.agents
  //    are owned by the right uid. Those two userns policies can't coexist in
  //    a shared namespace.
  //  - `runArgs: ["--network", "container:mainnet_node"]` → podman error
  //    "container is part of a pod, but container is not". mainnet_node is a
  //    pod member, so its network namespace can't be borrowed by a non-pod
  //    container.
  // The only way to enable true `--pod` membership would be to recreate the
  // systemd-ethereum pod WITHOUT `userns: host` on the infra — that touches a
  // running, days-synced validator and is not worth the risk. An `extraHosts`
  // alias (`node:host-gateway`) was also tried earlier but `host-gateway`
  // misresolves to 127.0.0.1 under rootless podman here, and extraHosts can't
  // take a hostname — only a literal IP or the token — so the alias approach
  // was dropped in favor of the resolved `host.containers.internal` hostname.
  // No `runArgs`/`network` field is used: host.containers.internal is wired up
  // by podman on every start, including the ssh-attach.sh `podman start`+`exec`
  // path that skips lifecycle hooks.
  "mounts": [
    "source=${localEnv:HOME}/.agents,target=/home/dev/.agents,type=bind",
    "source=${localEnv:HOME}/.config/degenbot,target=/home/dev/.config/degenbot,type=bind",
    "source=${localEnv:HOME}/.pi,target=/home/dev/.pi,type=bind",
    "source=${localEnv:HOME}/code/shared,target=/shared,type=bind"
  ],
  // PATH additions for the npm-global pi binary (~/.local/bin; npm prefix
  // in the Dockerfile makes `npm i -g` land there) and foundry
  // (~/.foundry/bin, curl-installed in the Dockerfile). Both are baked into the
  // image; these remoteEnv/containerEnv entries just ensure they're on PATH for
  // VSCode-launched shells too. cargo/just/node/python/uv are in /usr/bin from
  // dnf and already on the default PATH.
  // Network (host.containers.internal, see comment above) gives the dev
  // container host-loopback access to the local Ethereum node, so tests.env
  // points at host.containers.internal:8545/8546. Pod membership and
  // `--network=container:mainnet_node` were both attempted and rejected by
  // podman — details in the runArgs/network comment above.
  "containerEnv": {
    "LOCAL_BIN": "/home/dev/.local/bin",
    "FOUNDRY_DIR": "/home/dev/.foundry"
  },
  "remoteEnv": {
    "PATH": "/home/dev/.foundry/bin:/home/dev/.local/bin:${containerEnv:PATH}"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "echo 'degenbot devcontainer ready (fedora). Tools: just, uv, forge, pi, cargo, python3. Shared: /shared'"
}