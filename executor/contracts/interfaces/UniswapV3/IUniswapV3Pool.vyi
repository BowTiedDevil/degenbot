# Uniswap V3 Pool interface — matches UniswapV3Pool.sol
# Bytes size matches executor contracts (callers).

MAX_CALLBACK_DATA_LENGTH: constant(uint256) = 512

# ── Events (from IUniswapV3PoolEvents.sol) ──

event Swap:
    sender: indexed(address)
    recipient: indexed(address)
    amount0: int256
    amount1: int256
    sqrtPriceX96: uint160
    liquidity: uint128
    tick: int24

# ── Functions ──

@nonpayable
def swap(
    recipient: address,
    zeroForOne: bool,
    amountSpecified: int256,
    sqrtPriceLimitX96: uint160,
    data: Bytes[MAX_CALLBACK_DATA_LENGTH]
) -> (int256, int256):
    ...

@view
def token0() -> address:
    ...

@view
def token1() -> address:
    ...
