{
  "title": "degenbot observability overview",
  "uid": "degenbot-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "tags": ["degenbot", "mev"],
  "panels": [
    {
      "id": 1,
      "title": "Header \u2192 solved latency (p50/p95) - THE race number",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(degenbot_block_header_to_solved_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(degenbot_block_header_to_solved_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 2,
      "title": "Solve duration (p50/p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(degenbot_solve_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(degenbot_solve_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 3,
      "title": "Pipeline phase durations (p95): decode / apply / queue wait",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(degenbot_log_decode_seconds_bucket[5m])) by (le))",
          "legendFormat": "log decode"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(degenbot_state_apply_seconds_bucket[5m])) by (le))",
          "legendFormat": "state apply"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(degenbot_drain_queue_wait_seconds_bucket[5m])) by (le))",
          "legendFormat": "drain queue wait"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 4,
      "title": "Throughput: blocks observed / logs received / logs applied",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "rate(degenbot_blocks_observed_total[1m])",
          "legendFormat": "blocks/s"
        },
        {
          "expr": "rate(degenbot_logs_received_total[1m])",
          "legendFormat": "logs received/s"
        },
        {
          "expr": "rate(degenbot_logs_applied_total[1m])",
          "legendFormat": "logs applied/s"
        },
        {
          "expr": "rate(degenbot_backfills_executed_total[5m])",
          "legendFormat": "backfills/min"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "id": 5,
      "title": "Liveness: drain queue depth + state head lag (freeze signature)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "degenbot_drain_queue_depth",
          "legendFormat": "drain queue depth"
        },
        {
          "expr": "degenbot_state_head_lag_blocks",
          "legendFormat": "state head lag (blocks)"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 6,
      "title": "Solver load: registered paths / solves executed / candidates found",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "degenbot_engine_registered_paths",
          "legendFormat": "registered paths"
        },
        {
          "expr": "rate(degenbot_solves_executed_total[1m])",
          "legendFormat": "solves/min"
        },
        {
          "expr": "rate(degenbot_candidates_found_total[1m])",
          "legendFormat": "candidates/min"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 7,
      "title": "Simulate: duration p95 + verdict mix",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(degenbot_simulate_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "simulate p95"
        },
        {
          "expr": "sum(rate(degenbot_simulate_verdicts_total{outcome=\"profitable\"}[5m]))",
          "legendFormat": "profitable"
        },
        {
          "expr": "sum(rate(degenbot_simulate_verdicts_total{outcome=\"not_profitable\"}[5m]))",
          "legendFormat": "not profitable"
        },
        {
          "expr": "sum(rate(degenbot_simulate_verdicts_total{outcome=\"error\"}[5m]))",
          "legendFormat": "error"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 8,
      "title": "Submit outcomes by reason",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(rate(degenbot_submit_outcomes_total[5m])) by (outcome)",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "id": 9,
      "title": "Cumulative P&L: realized vs missed (wei)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "degenbot_profit_realized_total",
          "legendFormat": "realized (confirmed)"
        },
        {
          "expr": "degenbot_profit_missed_total",
          "legendFormat": "missed (found, unsubmitted)"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 }, "overrides": [] }
    },
    {
      "id": 10,
      "title": "Monitor outcomes + submit latency p95",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(rate(degenbot_monitor_outcomes_total[5m])) by (outcome)",
          "legendFormat": "monitor {{outcome}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(degenbot_submit_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "submit latency p95"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus"
      }
    ]
  }
}
