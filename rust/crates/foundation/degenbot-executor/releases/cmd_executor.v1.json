        {
          "name": "profit_mode",
          "bits": [
            0,
            7
          ],
          "allowed": [
            1,
            2
          ],
          "semantics": "measured balance domain: 1 = physical WETH + native ETH, 2 = PoolManager ERC6909 WETH claims; any other value reverts InvalidProfitMode"
        },
        {
          "name": "bribe_bips",
          "bits": [
            8,
            23
          ],
          "range": [
            0,
            10000
          ],
          "semantics": "bribe as basis points of gross profit, paid after measurement; 0 disables the bribe"
        },
        {
          "name": "bribe_recipient_idx",
          "bits": [
            24,
            31
          ],
          "range": [
            0,
            31
          ],
          "semantics": "0 = block.coinbase, 1-31 = address-table entry; sentinel indices are refused"
        },
        {
          "name": "min_profit",
          "bits": [
            32,
            255
          ],
          "semantics": "gross-profit floor in the selected mode; a smaller measurement reverts InsufficientProfit"
        }
      ]
