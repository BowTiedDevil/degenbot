# PoolManager interface — matches Uniswap V4's IPoolManager.sol
# Bytes sizes set to match executor contracts (callers), not the full 4096.
# The implementing contract (fake PM) uses larger sizes internally.

MAX_COMMANDS_LENGTH: constant(uint256) = 512
MAX_HOOK_DATA_LENGTH: constant(uint256) = 32

struct PoolKey:
    currency0: address
    currency1: address
    fee: uint24
    tick_spacing: int24
    hooks: address

struct SwapParams:
    zero_for_one: bool
    amount_specified: int256
    sqrt_price_limit_x96: uint160

struct ModifyLiquidityParams:
    tick_lower: int24
    tick_upper: int24
    liquidity_delta: int256
    salt: bytes32

# ── Events (from IPoolManager.sol) ──

event Initialize:
    id: indexed(bytes32)
    currency0: indexed(address)
    currency1: indexed(address)
    fee: uint24
    tick_spacing: int24
    hooks: address
    sqrt_price_x96: uint160
    tick: int24

event ModifyLiquidity:
    id: indexed(bytes32)
    sender: indexed(address)
    tick_lower: int24
    tick_upper: int24
    liquidity_delta: int256
    salt: bytes32

event Swap:
    id: indexed(bytes32)
    sender: indexed(address)
    amount0: int128
    amount1: int128
    sqrtPriceX96: uint160
    liquidity: uint128
    tick: int24
    fee: uint24

event Donate:
    id: indexed(bytes32)
    sender: indexed(address)
    amount0: uint256
    amount1: uint256

# ── Unlock ──

@nonpayable
def unlock(data: Bytes[MAX_COMMANDS_LENGTH]) -> Bytes[MAX_COMMANDS_LENGTH]:
    ...

# ── Pool lifecycle ──

@nonpayable
def initialize(
    key: PoolKey,
    sqrt_price_x96: uint160,
) -> int24:
    ...

@nonpayable
def modifyLiquidity(
    key: PoolKey,
    params: ModifyLiquidityParams,
    hook_data: Bytes[MAX_HOOK_DATA_LENGTH],
) -> (int256, int256):
    ...

@nonpayable
def donate(
    key: PoolKey,
    amount0: uint256,
    amount1: uint256,
    hook_data: Bytes[MAX_HOOK_DATA_LENGTH],
) -> int256:
    ...

# ── Core V4 operations ──

@nonpayable
def swap(
    key: PoolKey,
    params: SwapParams,
    hook_data: Bytes[MAX_HOOK_DATA_LENGTH],
) -> int256:
    ...

# ── Settlement and token movement ──

@payable
def settle():
    ...

@payable
def settleFor(recipient: address):
    ...

@nonpayable
def sync(currency: address):
    ...

@nonpayable
def take(
    currency: address,
    to: address,
    amount: uint256
):
    ...

@nonpayable
def clear(currency: address, amount: uint256):
    ...

# ── ERC6909 mint/burn ──

@nonpayable
def mint(to: address, id: uint256, amount: uint256):
    ...

@nonpayable
def burn(account: address, id: uint256, amount: uint256):
    ...

# ── Dynamic LP fee ──

@nonpayable
def updateDynamicLPFee(key: PoolKey, new_dynamic_lp_fee: uint24):
    ...
