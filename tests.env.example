# Copy to tests.env and edit. (tests.env is gitignored via the *.env rule.)
#
# RPC URIs are resolved with precedence:
#   1. environment variable  (e.g. TEST_ETHEREUM_ARCHIVE_NODE_HTTP_URI='...' pytest ...)
#   2. this file             (tests.env)
#   3. built-in default      (the public-node fallback shown below, see tests/conftest.py)
#
# A bare envvar override needs no file edit — useful for one-off runs, CI, or
# pointing at a local node from a non-devcontainer machine.
#
# ── These names are the test harness's, not operator configuration ──────────
#
# Every `TEST_*_ARCHIVE_*` / `TEST_*_FULL_*` name below belongs to the pytest/Ape harness
# (`tests/conftest.py::_rpc` owns the resolution above). They are deliberately
# NOT `DEGENBOT_RPC_{HTTP,WS}_CHAINID_<id>` operator names, and they are not
# candidates for the operator file's `[nodes]` tables: the suite needs two node
# tiers per chain (archive for historical state, full for the tip), while
# `[nodes]` holds one endpoint per transport per chain, so a second HTTP
# endpoint for the same chain has no table to fold into. Adding a
# `DEGENBOT_RPC_*` fallback inside `_rpc` is the ambiguity to avoid, not the fix.
# Out-of-process consumers share the names as an external contract rather than
# as configuration vocabulary: `executor/ape-config.yaml` reads
# `${TEST_ETHEREUM_FULL_NODE_HTTP_URI}`. User-facing documentation therefore shows
# a plain literal endpoint, never these names; the operator-side endpoint
# cascade belongs to the README's Configuration section.

TEST_ARBITRUM_FULL_NODE_HTTP_URI='https://arbitrum-one-rpc.publicnode.com'
TEST_ARBITRUM_FULL_NODE_WS_URI='wss://arbitrum-one-rpc.publicnode.com'

TEST_BASE_ARCHIVE_NODE_HTTP_URI='https://mainnet.base.org'
TEST_BASE_ARCHIVE_NODE_WS_URI='wss://mainnet.base.org'
TEST_BASE_FULL_NODE_HTTP_URI='https://mainnet.base.org'
TEST_BASE_FULL_NODE_WS_URI='wss://mainnet.base.org'

# Default points at a public node; override as needed
TEST_ETHEREUM_ARCHIVE_NODE_HTTP_URI='https://ethereum-rpc.publicnode.com'
TEST_ETHEREUM_ARCHIVE_NODE_WS_URI='wss://ethereum-rpc.publicnode.com'
TEST_ETHEREUM_FULL_NODE_HTTP_URI='https://ethereum-rpc.publicnode.com'
TEST_ETHEREUM_FULL_NODE_WS_URI='wss://ethereum-rpc.publicnode.com'

# ── Remote-endpoint rate caps (optional; both default OFF) ─────────────────
#
# Hosted free tiers enforce a per-IP budget (dRPC: 120k CU/min nominal,
# 50.4k CU/min floor). Two toggles keep the live lanes under it; both skip
# local endpoints (localhost/127.0.0.1/[::1]/host.containers.internal) by
# construction, so they are safe to leave set for a mixed local+remote setup.
#
# DEGENBOT_ANVIL_FORK_COMPUTE_UNITS_PER_SECOND  caps a forked anvil's upstream
#   fetching (otherwise spawned --no-rate-limit). 350 matches anvil's own
#   default and sits well under the free-tier floor.
# DEGENBOT_RPC_RATE_LIMIT_RPS  throttles AlloyProvider HTTP calls made without
#   an explicit caller limit (DEGENBOT_RPC_RATE_LIMIT_BURST sets the burst,
#   default: the rps).