@final
class SimulationDeployment:
    """
    One execution deployment a session fans its solved paths out to.

    Construct once per foreign contract, then hand the list to
    [`crate::simulation::batch::build_batch_executor_py`]'s `deployments`
    argument, in registration order, after the built-in settlement deployment
    (whose identity is [`builtin_deployment_id`]). Which of them each solved path
    is offered to is that function's `target_selection` policy: the default
    ordered walk stops at the first deployment whose composition accepts the
    path, and the explicit all-target fan-out offers every path to every entry.

    The adapter is an existing [`crate::execution::PyPayloadAdapter`] — the
    Python-authored Encode callable bound to the transaction it executes. This
    class adds the deployment facts calldata cannot carry (identity, owner,
    target, gas limit, optional declared runtime); it is not a second adapter
    framework and it invents no economics.
    """
    def __new__(
        cls,
        /,
        deployment_id: SupportsIndex,
        adapter: PayloadAdapter,
        owner: str,
        target: str,
        gas_limit: SupportsIndex,
        *,
        code: SupportsGetItem[int, SupportsIndex] | None = None,
    ) -> SimulationDeployment:
        """
        Compose one execution deployment from its adapter and declared facts.

        Args:
            `deployment_id`: the operator-assigned identity (a plain count). It
                must differ from every other deployment in the session — including
                the built-in settlement deployment's
                [`builtin_deployment_id`] — because every post-target row keys on
                `(path, deployment)`. Duplicates are refused at executor
                construction, not here.
            `adapter`: the Python execution adapter
                ([`crate::execution::PyPayloadAdapter`]) that encodes this
                contract's transaction and declares its probe reads and minimum
                net profit.
            `owner`: the account whose key sends the opportunity's transaction
                (the `from` of the simulated and submitted transaction). It must
                be the session signer's account; a foreign owner is refused at
                executor construction.
            `target`: the deployment's EXECUTION TARGET — the `to` of the
                transaction its adapter encodes. The submit join stamps this
                address, so a heterogeneous session routes each candidate to its
                own contract.
            `gas_limit`: the top-level gas limit the opportunity's transaction
                may burn.
            `code`: an optional declared runtime (bytecode) installed at THIS
                deployment's `target` in the simulated block — explicit
                development data for an undeployed build. The override installs
                only at the one address the adapter's transaction targets, so it
                can never simulate code the transaction does not run. `None`
                executes the code the chain holds at `target`.

        The deployment declares no settlement warmup (a foreign contract has no
        WETH or `PoolManager` identity) and keeps adapter-owned fee sizing (the
        adapter's own verdict, never the built-in market-aware re-pricing).

        # Errors

        `ValueError` when `owner`/`target` is not a valid EIP-55 address, when
        `code` is an empty runtime, or when `gas_limit` is zero (a deployment
        that may burn no gas has no opportunity to execute).
        """
    @property
    def declared_code(self, /) -> bytes | None:
        """
        The declared runtime installed at [`Self::target`] in the simulated
        block, or `None` when the deployment simulates the deployed contract.
        """
    @property
    def deployment_id(self, /) -> int:
        """
        The operator-assigned deployment identity (the deployment half of every
        [`crate::simulation::identity::PyCandidateId`] this deployment
        executes).
        """
    @property
    def gas_limit(self, /) -> int:
        """
        The top-level gas limit the opportunity's transaction may burn.
        """
    @property
    def owner(self, /) -> str:
        """
        The account whose key sends this deployment's transactions (the `from`;
        EIP-55 checksummed).
        """
    @property
    def target(self, /) -> str:
        """
        The deployment's execution target — the `to` its adapter encodes
        (EIP-55 checksummed).
        """

@disjoint_base
class SubmitVerdict:
    """
    Stage 3 — the submit receipt or typed failure (the core's typed enum; no
    drain reads inside this slot today — the raw submit-lane records the
    Python renderers consume ride `BatchOutcomeSet.submit_records`).
    """
    @final
    class Failed(SubmitVerdict):
        """
        The candidate reached the submit lane and did not broadcast.
        """

        __match_args__: Final = ("kind",)
        def __new__(cls, /, kind: FailureKind) -> SubmitVerdict.Failed: ...
        @property
        def kind(self, /) -> FailureKind:
            """
            The typed failure taxonomy member.
            """

    @final
    class Submitted(SubmitVerdict):
        """
        The tx was broadcast.
        """

        __match_args__: Final = ()
        def __getitem__(self, key: SupportsIndex, /) -> Any: ...
        def __len__(self, /) -> int: ...
        def __new__(cls, /) -> SubmitVerdict.Submitted: ...

@final
class ZeroCapitalDeficit:
    """
    A **typed zero-capital deficit** — the capital-policy refusal a stream's
    ledger evaluation answers with when the executor's declared entry capital
    cannot fund it.

    The three fields are the whole answer, so a consumer reports *what is
    missing* instead of parsing a message: `asset` is the currency the stream
    could not fund (checksummed, the same spelling every operator/diagnostic
    surface uses), `required` is the amount the failing step demanded, and
    `available` is the path-generated credit on hand at that point. It rides
    [`PyFailureDetail::zero_capital`], `None` for every ordinary failure (a
    revert, `no-profit`, an `encode-failed` grammar gap, an orchestration skip),
    so the two refused-stream kinds stay distinguishable by data.
    """
    @property
    def asset(self, /) -> str:
        """
        The currency the stream could not fund (native is the zero address),
        checksummed.
        """
    @property
    def available(self, /) -> int:
        """
        The path-generated credit available at that point.
        """
    def record(self, /) -> dict:
        """
        The record dict this deficit crosses the renderer/diagnostic boundary as
        (the same three fields, never a prose sentence).
        """
    @property
    def required(self, /) -> int:
        """
        The amount the failing step demanded.
        """

def build_batch_executor_py(
    context: SimulateContext,
    dispatcher: Dispatcher,
    engine: ArbitrageEngine,
    signer: TxSigner,
    submit_provider: AsyncAlloyProvider,
    operator_nonce: SupportsIndex,
    *,
    dry_run: bool,
    broadcast_providers: SupportsGetItem[int, AsyncAlloyProvider] | None = None,
    deployments: SupportsGetItem[int, SimulationDeployment] | None = None,
    target_selection: str | None = None,
) -> BatchExecutor:
    """
    Construct the session executor: the core's value-configured module over
    the INSTALLED verdict — the policy values (the cap, the thin-margin
    floor, the ERC6909 encode axis, the inject guards) convert from the same
    resolved config the Python verdict projects, with every default and
    clamp owned by that conversion. The driver injects only the runtime
    handles the verdict cannot name. Choreography code NEVER crosses.

    Args:
        `context`: the session `SimulateContext` (provider, addresses, the
            inject stance's runtime facts, runtime bytecode, warmup slots).
        `dispatcher`: the session `Dispatcher` (the coordination arcs ride it:
            suppression, divergence, `FoT`, priority-fee ring).
        `engine`: the `ArbEngine` (the path resolver projection + the
            `BotState`/warm-code arcs).
        `signer`: the operator `TxSigner` (constructed ONCE; the key never
            leaves Rust).
        `submit_provider`: the read/broadcast provider handle.
        `operator_nonce`: the construction-time chain-read nonce seed (the
            lane's first stamp never re-issues a consumed nonce; the hosted
            per-head reconcile maintains it afterwards).
        `dry_run`: skip live submission (the driver's run-mode stance — a CLI
            fact, not a declared key).
        `broadcast_providers`: the relay fan-out (the `RelayPosture` value's
            endpoints); `None`/empty = the public mempool (read provider
            only).
        `deployments`: the session's ADDITIONAL execution deployments (foreign
            contracts), registered after the built-in settlement deployment in
            the order given. `None`/empty is the one-entry built-in session with
            unchanged behavior; with entries present, which targets each solved
            path is offered to is `target_selection`'s decision, and each
            candidate's submit row carries its own deployment's target
            (ADR-098 D4).
        `target_selection`: which deployments each solved path is offered to —
            `"first_compatible"` (the default) or `"all_targets"`
            ([`degenbot_arbitrage::TargetSelection`]). The default walks the
            registry in order and executes at the first deployment whose
            composition accepts the path; a capability refusal advances to the
            next target, and later targets are never composed. `"all_targets"`
            is the explicit fan-out: every registered deployment is offered
            every path. One registered deployment selects the same target either
            way.

    This constructor builds the SUBMITTING lane over the session's own capital
    (`Production`), so it takes no capital posture: an explicit execution probe
    is [`crate::simulation::probe::build_probe_executor_py`]'s value, which has
    no signer, nonce lane, or broadcast arm to arm.

    # Errors

    `ValueError` on malformed addresses/args, an unknown `target_selection` or
    `capital` spelling, or when the composed registry is refused: a deployment
    reusing an
    existing identity (including the built-in
    [`crate::simulation::deployment::builtin_deployment_id`]) makes every
    post-target row ambiguous, and a deployment whose owner is not the session
    signer's account could not be signed for. Both are the core
    [`degenbot_arbitrage::DeploymentRegistry`]'s refusals, mapped here.

    `RuntimeError` when `simulation.delta_dispatch` is ON and the startup BAL
    capability probe refuses — the session never gets an executor, an armed
    pipeline, or a batch. A LINEAGE failure (an unreadable head number, or a head
    with no complete canonical lineage) names the endpoint's health and
    canonical-header availability, because it never reached a BAL method; an
    ACQUISITION/DECODE failure names both official methods and the remediation —
    enable EIP-7928 BAL RPC support on the endpoint, or disable
    `simulation.delta_dispatch`. An OFF session never probes.
    """

def build_probe_executor_py(
    context: SimulateContext,
    dispatcher: Dispatcher,
    engine: ArbitrageEngine,
    provider: AsyncAlloyProvider,
    *,
    capital: str | None = None,
    deployments: SupportsGetItem[int, SimulationDeployment] | None = None,
    target_selection: str | None = None,
) -> ProbeExecutor:
    """
    Construct a probe executor for ONE capital posture.

    The construction is the sim half of the session executor's and nothing else:
    no signer, no nonce seed, no submit provider, no relay endpoints, and no
    run-mode stance cross this boundary, because a probe has no submit lane to
    arm. The verdict still supplies every policy value (the thin-margin floor,
    the ERC6909 encode axis, the inject stance) through the core's own
    conversion, so a probe's answers are the session's answers.

    Args:
        `context`: The session `SimulateContext` (provider, addresses, the
            inject stance's runtime facts, runtime bytecode, warmup slots).
        `dispatcher`: The session `Dispatcher` (suppression, divergence, `FoT`,
            priority-fee ring).
        `engine`: The `ArbEngine` (the path resolver projection, the path
            registry the nonce lookup reads, `BotState`/warm-code arcs).
        `provider`: The sim provider handle (`AsyncAlloyProvider`).
        `capital`: The ONE capital posture: `"production"` (default),
            `"self_fund"`, or `"zero_balance"`.
        `deployments`: The session's ADDITIONAL execution deployments, offered
            after the built-in settlement deployment in the order given.
        `target_selection`: `"first_compatible"` (the default) or
            `"all_targets"` — which deployments each path is offered to.

    Raises:
    # Errors

    `ValueError` on an unknown `capital`/`target_selection` spelling, or when the
    composed registry is refused (an empty registry, two deployments with one
    identity, or a deployment owned by another account).

    `RuntimeError` when `simulation.delta_dispatch` is ON and the startup BAL
    capability probe refuses.
    """

def builtin_deployment_id() -> int:
    """
    The identity the built-in settlement deployment is registered under.

    [`ExecutorConfig::from_verdict`] registers it as the FIRST entry of every
    session's deployment registry, so a session that names no additional
    deployment is that one entry. A Python deployment that reused this number
    would make every post-target row ambiguous, so the executor constructor
    refuses it — the number itself is the core's to name, which is why it is
    read here rather than restated in Python.
    """

def executor_policy_py(values: ConfigValues) -> ExecutorPolicyValues:
    """
    The verdict-named executor policy, as the resolution oracle reads it: the
    SAME conversion the executor construction runs, exposed so a Python test
    can pin every knob against the verdict's own values.

    Args:
        `values`: the typed projection (`resolved_config().values`, or a
            hypothetical resolution's) the policy converts from.

    Returns:
        `ExecutorPolicyValues`: the converted policy (the cap with its floor,
        the thin-margin floor, the ERC6909 axis, both inject guards).
    """

def merge_payload_results_py(
    payloads: list, engine: ArbitrageEngine, executor_address: str
) -> PayloadOutcome:
    """
    The payload arm of the sim seam: derive the dispatch-policy
    facts for the engine's inline-sim payload records Rust-side, through the
    SAME row builder the FFI batch join uses.

    Each payload dict is the `result_channel` serializer's primitive field-set
    (`path_id` / `gross_profit` / `net_profit` / `gas_used` / `priority_fee` /
    `base_fee_next` / `execute_calldata` / `access_list` / `failure`). Per entry:

    1. The registered path's typed hops are resolved via the SAME
       engine projection the FFI batch candidates use
       (`PyArbEngine::path_info_for_core`) and routed through
       `join_sim_result` → `derive_path_pools` — the mutual-exclusion set is
       byte-identical to the FFI batch row for the same path id, by
       construction (V4 → `pool_id_hex`; V2/V3 → EIP-55 Display).
    2. Categorization applies the core's `is_gas_profitable` predicate ONCE
       (the same `MIN_PROFIT_NET` floor the FFI batch fan-out applies: a net
       at or above the floor submits; below counts gas-unprofitable). A
       failure payload becomes a sim-fail row.
       Python receives the verdict as a `kind` string only — it never reads
       the threshold value.
    3. The boundary extracts the payload's primitive fields into the crate
       `PayloadRow`, and the crate-owned join reassembles the core row, so a
       submit row is the exact shape the submit seam consumes.

    Args:
        payloads: list of payload dicts (one per inline-sim entry).
        engine: the `PyArbEngine` (the typed-hop resolver — the same
            engine the payload-producing result batch came from).
        `executor_address`: the session executor contract (the join stamps it
            identically on every row, like the batch arm's join does).

    Returns:
        `PayloadOutcome` — the merged record set Python renders (submit rows,
        unprofitable tally, sim-fail rows, `path_infos`, captured swaps are
        empty on the payload arm: the engine's inspector capture rides the
        render dict, not a `CapturedSwap` vector).

    # Errors

    `ValueError`: a payload dict is missing a required field, the calldata is
    not bytes, a `path_id` is not registered in the engine (the pool-key
    derivation needs the typed hops), a payload's `deployment_id` is not this
    session's built-in deployment — a foreign payload would carry another
    deployment's calldata into the built-in submit lane — or two payload rows for
    one candidate would BOTH join that lane: one `CandidateId` is one live submit
    row (`AssemblyError::DuplicateCandidateId`), so Python reads the identity and
    the row count instead of receiving two submit rows for one candidate.

    The corruption arm's message is the bare `detail` (`payload row carries
    deployment 2, but this batch executes deployment 1`), exactly as before the
    error grew a second variant; only the identity refusal renders the crate's
    `Display`.
    """

def quote_execution_probe_py(
    engine: ArbitrageEngine,
    provider: AsyncAlloyProvider,
    path_id: SupportsIndex,
    optimal_input: SupportsIndex,
    current_block: SupportsIndex,
) -> Any:
    """
    Price one registered path's FIXED input at ONE block and state the result as
    the typed [`PyExecutionProbeRequest`] the probe executor runs.

    This is the operator surface's only quote call: the core's exact-input quote
    interface does the derivation (`EngineStages::quote_exact_input_path`) — the
    reserve-pair hop through the production pool math over that pair's reserves at
    `current_block`, the V3/V4 hops through the canonical on-chain quoters at
    `current_block` — and this wrapper only narrows
    the answer into the request the typed probe protocol already accepts.

    The returned request's `hop_outputs` / `consumed_inputs` are one entry per
    hop in path order, and its block context is the SAME block the vector was
    quoted at. A refusal (an unregistered path, an unregistered pool, a hop with
    no quote arm, a quoter revert) is typed here rather than surfacing as a blank
    vector: a probe cannot run on a partial quote.

    Args:
        `engine`: The `ArbEngine` (the path registry + shared pool state).
        `provider`: The session provider handle (the quoter transport).
        `path_id`: The registered engine path to quote.
        `optimal_input`: The fixed swap input (wei); must be positive.
        `current_block`: The ONE block the vector and its context belong to.

    Raises:
    # Errors

    `ValueError`: `optimal_input` is not positive, the path is not registered,
    a hop has no exact-input arm, or a quoted amount exceeds the request's
    128-bit fields.

    `RuntimeError`: A hop's pool is not registered, the in-process pool math
    refuses a hop, a reserve-pair hop's reserves at `current_block` cannot be
    read (or are wider than the pool's `uint112` fields), the canonical quoter
    refuses a hop, or the block context cannot be read.
    """

def simulate_in_process_revert_probe(path_id: SupportsIndex, runtime_bytecode: bytes) -> dict:
    """
    Drive the `0xcafebabe`-style REVERT fixture (executor injected with
    caller-supplied runtime bytecode) through the in-process evm2 EVM —
    ADR-005 Tier-2 dual-driver parity entrypoint for the inspector.

    The fixture (addresses, 2-hop V2 path, block env) is hardcoded to mirror
    the Rust smoke test; the caller supplies only `path_id` (so it round-trips
    through the FFI) + `runtime_bytecode` (the executor's injected bytecode —
    e.g. the `0xcafebabe` REVERT stub or `0xfe` INVALID).

    Returns a dict:
      - `result` (`None`) — the in-process path returns `None` for reverts
        + non-profitable outcomes (the revert is tallied in `failures`).
      - `failures` (`list[dict]`) — one entry per failed candidate, each
        carrying `candidate` (the nested `path_id` + `deployment_id` identity),
        `bucket`, `fail_index`, `revert_data`,
        `reverting_frame`, `captured_swaps`, `optimal_input`, `hop_outputs`
        (the same shape the batch seam's `FailureDetail.record()` emits).
      - `fail_buckets` (`dict[str, int]`) — the bucket tally.

    No RPC. `CacheDB<EmptyDB>` handles all state reads (empty → zero). The
    provider is a mock with an empty queue (errors if somehow called).

    # Errors

    `RuntimeError` only on an unrecoverable evm2 `transact` error (a DB
    cold-miss RPC failure — cannot happen over `CacheDB<EmptyDB>`, but the
    `ProviderResult` is honored for parity with the production signature).
    """

def simulate_in_process_success_probe(path_id: SupportsIndex) -> dict:
    """
    Drive the SELFDESTRUCT-gift success-path fixture through the in-process
    evm2 EVM — the ADR-005 Tier-2 dual-driver parity entrypoint for the
    success-path `SimResult` (gross/net/gas).

    The fixture (identical to the Rust `parity_evm_sim.rs` test): the executor
    stub bytecode CALLs a gift contract; the gift `SELFDESTRUCT`s to the
    executor (`CALLER`), sending its 1 ETH balance, and the stub returns the
    receipt `(1 ETH, 0)` → `gross_profit = 1 ETH` → a non-None `SimResult`.

    The caller supplies only `path_id` (round-trips through the FFI); every
    other fixture detail is hardcoded to mirror the Rust parity test.

    Returns a dict:
      - `result` (`dict`) — the `SimResult` as a Python dict (`gross_profit`,
        `net_profit`, `gas_used`, `priority_fee`, `base_fee_next`, `captured_swaps`,
        `hop_count`) when the path is profitable. KeyError-free.
      - `failures` (`list[dict]`) — empty for the success path (same shape as
        `simulate_in_process_revert_probe` for symmetry).
      - `fail_buckets` (`dict`) — empty for the success path.

    No RPC. `CacheDB<EmptyDB>` handles all reads. The provider is a mock with
    an empty queue (errors if somehow called).

    # Errors

    `RuntimeError` only on an unrecoverable evm2 `transact` error (cannot
    happen over `CacheDB<EmptyDB>`) or if the fixture regresses to a non-None
    bucket (a `debug_assert!` fires + is surfaced as `RuntimeError`).
    """

