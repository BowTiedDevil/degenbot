class SessionConsumerError(RuntimeError):
    """
    A session consume-loop abort: a pipeline leaf failure, or a lifecycle refusal. A leaf failure's message is the leaf's own detail under the shared loud-abort prefix; a refusal (no attached session, a spent claim, the driver refusing the move, or a second attach) is prefix-free and carries the refusal's own text, because no leaf ran. `kind` is the core `ConsumerErrorKind` classification (`None` for an adapter-local slot refusal); `batch_index` is the batch whose pass failed and `report` the counts the loop reached before it stopped (the typed consumer report).
    """

    batch_index: int
    kind: ConsumerErrorKind | None
    report: dict[str, Any]

